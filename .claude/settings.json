{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gsd-console-mirror.mjs\" \"https://gsd-console.titaniumlabs.us\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gsd-console-mirror.mjs\" \"https://gsd-console.titaniumlabs.us\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
